#!/usr/bin/env bash
# air-remote-claude — stand-in for `claude` that JetBrains Air can launch.
# It runs the real claude on a remote box over ssh, keeps the project mirrored
# with Mutagen, routes Air's hooks back through a local proxy that rewrites box
# paths to local ones, and copies transcripts back so Air can find them in the
# local ~/.claude.
#
# Point Air's claude executable at this file (or put it first on PATH as `claude`)
# for terminal mode. For chat mode, register the ACP adapter as a custom agent in
# ~/.jetbrains/acp.json with CLAUDE_CODE_EXECUTABLE set to this file.
# Needs locally: ssh, mutagen, python3 (stdlib only, for the hook proxy).
#
# Configuration (environment variables):
#   AIR_REMOTE_HOST    ssh host alias of the box (required; unset → run local claude)
#   AIR_REMOTE_CLAUDE  claude command on the box             (default: claude)
#   AIR_REMOTE_DIR     project dir on the box: absolute, or relative to its $HOME
#                      (default: local $PWD relative to local $HOME)
#   AIR_LOCAL_CLAUDE   real local claude, used when AIR_REMOTE_HOST is unset
#   AIR_LOG            log file              (default: ~/.cache/air-remote-claude.log)
#
# Maintenance:
#   air-remote-claude --air-status    list this script's mutagen sessions
#   air-remote-claude --air-cleanup   terminate them
set -euo pipefail

LOG="${AIR_LOG:-$HOME/.cache/air-remote-claude.log}"
mkdir -p "$(dirname "$LOG")"
touch "$LOG" && chmod 600 "$LOG" # the settings file carries Air's hook token

log() { printf '%s [%s] %s\n' "$(date +%T)" "$$" "$*" >>"$LOG"; }
die() { log "FATAL: $*"; printf 'air-remote-claude: %s\n' "$*" >&2; exit 1; }

# Claude's transcript dir name: every non-alphanumeric character becomes '-'.
encode_path() { printf '%s' "$1" | sed 's/[^a-zA-Z0-9]/-/g'; }

# Mutagen names must start with a letter and hold only letters, digits, dashes.
mutagen_name() { printf 'air-%s' "$(encode_path "$1" | sed 's/^-*//; s/--*/-/g' | cut -c1-50)"; }

case "${1:-}" in
  --air-status)  exec mutagen sync list --label-selector app=air-remote-claude ;;
  --air-cleanup) exec mutagen sync terminate --label-selector app=air-remote-claude ;;
esac

log "---- invoked: pwd=$PWD"
log "argv: $*"
env | grep -iE '^(CLAUDE|ANTHROPIC|JETBRAINS|IDEA|AIR|TERM|COLORTERM)' | sed 's/^/env: /' >>"$LOG" || true

if [[ -z "${AIR_REMOTE_HOST:-}" ]]; then
  local_claude="${AIR_LOCAL_CLAUDE:-}"
  [[ -n "$local_claude" ]] || die "AIR_REMOTE_HOST unset and AIR_LOCAL_CLAUDE not given"
  log "no remote host: exec local $local_claude"
  exec "$local_claude" "$@"
fi
HOST="$AIR_REMOTE_HOST"

# ---- 0. Utility subcommands: run on the box, no project or sync -------------
# The ACP adapter calls e.g. `claude auth status` before every prompt; those
# need the box's login, not a mirrored project.
case "${1:-}" in
  auth|mcp|config|doctor|update|install|plugin|setup-token|-v|--version|-h|--help)
    log "utility call: $*"
    exec ssh -T -o BatchMode=yes "$HOST" \
      "bash -lc $(printf %q "exec ${AIR_REMOTE_CLAUDE:-claude}$(printf ' %q' "$@")")"
    ;;
esac

# The caller's stdin is reserved for the final claude: in headless mode the
# Agent SDK writes its initialize request immediately, and any setup ssh that
# inherits stdin would forward (and so swallow) it. Setup commands read
# /dev/null; fd 3 keeps the original.
exec 3<&0 </dev/null

# ---- 1. Rewrite Air's arguments -------------------------------------------
# --settings <file> becomes inline JSON (the file exists only locally); the
# session id is remembered so transcripts can be matched up.
args=() session_id="" mode="" settings_json=""
while (($#)); do
  case "$1" in
    --settings)        settings_json="$(cat "$2")"; args+=(--settings "$settings_json"); shift 2 ;;
    --settings=*)      settings_json="$(cat "${1#*=}")"; args+=(--settings "$settings_json"); shift ;;
    --session-id|--resume) mode="$1"; session_id="$2"; args+=("$1" "$2"); shift 2 ;;
    --session-id=*|--resume=*) mode="${1%%=*}"; session_id="${1#*=}"; args+=("$1"); shift ;;
    *)                 args+=("$1"); shift ;;
  esac
done
log "mode=${mode:-none} session=${session_id:-none}"

# ---- 2. Air's hook ports --------------------------------------------------
# Air's hooks POST to http://localhost:<port>/...; step 6 opens the same port on
# the box and tunnels it to a local path-rewriting proxy in front of Air.
air_ports=()
if [[ -n "$settings_json" ]]; then
  while read -r port; do
    [[ -n "$port" ]] || continue
    air_ports+=("$port")
    log "hook port: $port"
  done < <(grep -oE '(localhost|127\.0\.0\.1):[0-9]+' <<<"$settings_json" | cut -d: -f2 | sort -u)
fi

# ---- 3. Paths on both ends ------------------------------------------------
LOCAL_DIR="$PWD"
case "$LOCAL_DIR/" in
  "$HOME"/*) rel="${LOCAL_DIR#"$HOME"/}" ;;
  *) [[ -n "${AIR_REMOTE_DIR:-}" ]] || die "$LOCAL_DIR is outside \$HOME; set AIR_REMOTE_DIR" ;;
esac
REMOTE_HOME="$(ssh -o BatchMode=yes "$HOST" 'printf %s "$HOME"')" || die "ssh $HOST failed"
case "${AIR_REMOTE_DIR:-}" in
  /*) REMOTE_DIR="$AIR_REMOTE_DIR" ;;                     # absolute: used as-is
  *)  REMOTE_DIR="$REMOTE_HOME/${AIR_REMOTE_DIR:-$rel}" ;; # relative to the box's $HOME
esac

LOCAL_TRANSCRIPTS="$HOME/.claude/projects/$(encode_path "$LOCAL_DIR")"
REMOTE_TRANSCRIPTS="$REMOTE_HOME/.claude/projects/$(encode_path "$REMOTE_DIR")"
log "local  dir=$LOCAL_DIR transcripts=$LOCAL_TRANSCRIPTS"
log "remote dir=$REMOTE_DIR transcripts=$REMOTE_TRANSCRIPTS"

ssh -o BatchMode=yes "$HOST" "mkdir -p $(printf %q "$REMOTE_DIR") $(printf %q "$REMOTE_TRANSCRIPTS")" \
  || die "cannot create remote dirs"
mkdir -p "$LOCAL_TRANSCRIPTS"

# ---- 4. Mutagen sessions (shared per project, reused across Air chats) ----
ensure_sync() { # name alpha beta mode
  local name="$1" alpha="$2" beta="$3" sync_mode="$4"
  if mutagen sync list "$name" >/dev/null 2>&1; then
    log "mutagen $name: resume"
    mutagen sync resume "$name" >>"$LOG" 2>&1 || true
  else
    log "mutagen $name: create ($sync_mode) $alpha -> $beta"
    mutagen sync create --name "$name" --label app=air-remote-claude \
      --mode "$sync_mode" "$alpha" "$beta" >>"$LOG" 2>&1 \
      || die "mutagen create $name failed (see $LOG)"
  fi
}

PROJECT_SYNC="$(mutagen_name "$LOCAL_DIR")"
TRANSCRIPT_SYNC="${PROJECT_SYNC}-tx"

# Project: two-way, local wins conflicts.
ensure_sync "$PROJECT_SYNC" "$LOCAL_DIR" "$HOST:$REMOTE_DIR" two-way-resolved
# Transcripts: box → local only. one-way-safe never deletes local-only files.
ensure_sync "$TRANSCRIPT_SYNC" "$HOST:$REMOTE_TRANSCRIPTS" "$LOCAL_TRANSCRIPTS" one-way-safe

log "flushing project sync"
mutagen sync flush "$PROJECT_SYNC" >>"$LOG" 2>&1 || log "project flush failed (continuing)"

# ---- 5. --resume of a chat that only exists locally -----------------------
# The transcript sync only flows box → local, so push the one file up by hand.
if [[ "$mode" == --resume* && -n "$session_id" ]]; then
  local_tx="$LOCAL_TRANSCRIPTS/$session_id.jsonl"
  if [[ -f "$local_tx" ]] && ! ssh "$HOST" "test -f $(printf %q "$REMOTE_TRANSCRIPTS/$session_id.jsonl")"; then
    log "pushing local transcript for resume: $local_tx"
    scp -q "$local_tx" "$HOST:$REMOTE_TRANSCRIPTS/" || log "transcript push failed"
  fi
fi

# ---- 6. Run claude on the box ---------------------------------------------
# Login shell so the box's PATH (e.g. ~/.local/bin) is loaded; every argument is
# %q-quoted to survive both the remote login shell and bash -lc.
# The caller's CLAUDE_*/ANTHROPIC_* environment (the Agent SDK sets several) is
# carried over; local paths in the arguments become box paths.
remote_cmd="cd $(printf %q "$REMOTE_DIR") && exec env"
fwd_env=()
for v in $(compgen -e); do
  case "$v" in
    CLAUDE_CODE_EXECUTABLE) ;; # points at this wrapper, meaningless on the box
    CLAUDE_*|ANTHROPIC_*|MAX_THINKING_TOKENS)
      remote_cmd+=" $(printf %q "$v=${!v}")"; fwd_env+=("$v") ;;
  esac
done
log "forwarded env: ${fwd_env[*]:-none}"
remote_cmd+=" ${AIR_REMOTE_CLAUDE:-claude}"
for a in "${args[@]}"; do
  a="${a//"$LOCAL_TRANSCRIPTS"/"$REMOTE_TRANSCRIPTS"}"
  a="${a//"$LOCAL_DIR"/"$REMOTE_DIR"}"
  remote_cmd+=" $(printf %q "$a")"
done

tty_flag=-T
[[ -t 3 && -t 1 ]] && tty_flag=-tt

# Hook proxy: Claude on the box reports box paths (cwd, transcript_path, edited
# file_path); Air only recognises its own project paths. Requests are rewritten
# box → local before reaching Air, Air's replies local → box on the way back.
# Every JSON string is rewritten, not just known fields, so paths inside tool
# input/response are covered too.
PROXY_PY=$(cat <<'PY'
import http.server, json, sys, time, urllib.error, urllib.request

air_port, port_file = int(sys.argv[1]), sys.argv[2]
remote, local = sys.argv[3::2], sys.argv[4::2]
by_len = lambda p: -len(p[0])  # longest prefix first
to_local = sorted(zip(remote, local), key=by_len)
to_remote = sorted(zip(local, remote), key=by_len)

def rewrite(o, pairs):
    if isinstance(o, str):
        for a, b in pairs:
            o = o.replace(a, b)
        return o
    if isinstance(o, list):
        return [rewrite(x, pairs) for x in o]
    if isinstance(o, dict):
        return {k: rewrite(v, pairs) for k, v in o.items()}
    return o

def recode(raw, pairs):
    try:
        return json.dumps(rewrite(json.loads(raw), pairs)).encode(), True
    except ValueError:
        return raw, False

def log(msg):
    print(time.strftime("%T"), "[proxy:%d]" % air_port, msg, file=sys.stderr, flush=True)

class Hook(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        raw = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        try:
            event = json.loads(raw).get("hook_event_name")
        except (ValueError, AttributeError):
            event = None
        body, _ = recode(raw, to_local)
        req = urllib.request.Request(
            "http://localhost:%d%s" % (air_port, self.path), data=body, method="POST")
        for h in ("Authorization", "Content-Type"):
            if self.headers.get(h):
                req.add_header(h, self.headers[h])
        started = time.monotonic()
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                status, data, ctype = r.status, r.read(), r.headers.get("Content-Type")
        except urllib.error.HTTPError as e:
            status, data, ctype = e.code, e.read(), e.headers.get("Content-Type")
        except Exception as e:
            log("%s -> Air unreachable: %s" % (event, e))
            self.send_response(502)
            self.end_headers()
            return
        data, _ = recode(data, to_remote)
        log("%s -> %d in %dms, reply %s" % (
            event, status, (time.monotonic() - started) * 1000, data[:200]))
        self.send_response(status)
        if ctype:
            self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *args):
        pass

srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Hook)
with open(port_file, "w") as f:
    f.write(str(srv.server_address[1]))
srv.serve_forever()
PY
)

proxy_pids=()
start_proxy() { # air_port → sets proxy_port (no subshell, so proxy_pids survives)
  local air_port="$1" port_file
  proxy_port=""
  port_file="$(mktemp)"
  python3 -I -c "$PROXY_PY" "$air_port" "$port_file" \
    "$REMOTE_DIR" "$LOCAL_DIR" "$REMOTE_TRANSCRIPTS" "$LOCAL_TRANSCRIPTS" >>"$LOG" 2>&1 &
  proxy_pids+=($!)
  for _ in $(seq 50); do
    proxy_port="$(cat "$port_file")"
    [[ -n "$proxy_port" ]] && break
    sleep 0.1
  done
  rm -f "$port_file"
  [[ -n "$proxy_port" ]] || die "hook proxy for port $air_port did not start (see $LOG)"
}

on_exit() {
  local rc=$?
  ((${#proxy_pids[@]})) && kill "${proxy_pids[@]}" 2>/dev/null
  log "claude exited rc=$rc; flushing syncs"
  mutagen sync flush "$TRANSCRIPT_SYNC" >>"$LOG" 2>&1 || log "transcript flush failed"
  mutagen sync flush "$PROJECT_SYNC" >>"$LOG" 2>&1 || log "project flush failed"
  if [[ -n "$session_id" ]]; then
    if [[ -f "$LOCAL_TRANSCRIPTS/$session_id.jsonl" ]]; then
      log "transcript present locally: $LOCAL_TRANSCRIPTS/$session_id.jsonl"
    else
      log "transcript MISSING locally for $session_id"
    fi
  fi
}
trap on_exit EXIT

# The box keeps Air's port number (so the inlined settings need no change), but
# its tunnel ends at the proxy instead of Air. A stale listener on the box makes
# ssh warn, not fail.
command -v python3 >/dev/null || die "python3 is required for the hook proxy"
fwd=()
for air_port in "${air_ports[@]}"; do
  start_proxy "$air_port"
  fwd+=(-R "$air_port:localhost:$proxy_port")
  log "hook proxy: box :$air_port -> local proxy :$proxy_port -> Air :$air_port"
done

log "ssh $tty_flag ${fwd[*]:-} $HOST (claude args: ${#args[@]})"
# ControlPath=none: a shared master connection would silently drop the -R forwards.
run_remote() {
  ssh "$tty_flag" -o ControlPath=none -o ExitOnForwardFailure=no "${fwd[@]}" "$HOST" \
    "bash -lc $(printf %q "$remote_cmd")"
}

# Headless (stream-json) mode: Air drives claude over stdin/stdout instead of a
# terminal, and reads tool calls and file paths from that stream, so paths are
# rewritten there too: Air → box on stdin, box → Air on stdout. Line-buffered,
# since each line is one protocol message.
REWRITE_PY='
import sys
pairs = sorted(zip(sys.argv[1::2], sys.argv[2::2]), key=lambda p: -len(p[0]))
while line := sys.stdin.readline():
    for a, b in pairs:
        line = line.replace(a, b)
    sys.stdout.write(line)
    sys.stdout.flush()
'
to_box()   { python3 -I -u -c "$REWRITE_PY" "$LOCAL_DIR" "$REMOTE_DIR" "$LOCAL_TRANSCRIPTS" "$REMOTE_TRANSCRIPTS"; }
from_box() { python3 -I -u -c "$REWRITE_PY" "$REMOTE_DIR" "$LOCAL_DIR" "$REMOTE_TRANSCRIPTS" "$LOCAL_TRANSCRIPTS"; }

# Air's terminal mode always has a TTY; the Agent SDK (ACP chat) never does.
if [[ ! -t 3 ]]; then
  # Captures hold exactly what Air sent and received (local paths).
  log "headless call: capturing I/O to $LOG.io-$$.{in,out}"
  umask 077 # the captures hold prompts and replies
  tee "$LOG.io-$$.in" <&3 | to_box | run_remote | from_box | tee "$LOG.io-$$.out"
  rc=("${PIPESTATUS[@]}")
  log "headless pipeline exit codes: ${rc[*]}"
  exit "${rc[2]}"
fi
run_remote <&3
