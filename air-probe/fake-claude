#!/usr/bin/env python3
"""fake-claude: a stand-in `claude` that records how JetBrains Air (directly, in
terminal mode, or through the ACP adapter, in chat mode) starts and ends it.
No model runs: every prompt gets a canned reply.

Each invocation writes one JSON-lines log, $AIR_PROBE_DIR/<time>-<pid>-claude.log
(default ~/.cache/air-probe), with: argv, selected env, cwd, process ids, tty
state; every stdin line; stdin EOF; every signal received; exit.

Use it as CLAUDE_CODE_EXECUTABLE (chat mode) or as Air's claude path (terminal).

Knobs:
  AIR_PROBE_DIR            log directory
  AIR_PROBE_IGNORE_TERM=1  log SIGTERM/SIGHUP but keep running, to see whether
                           the caller escalates to SIGKILL and when
  AIR_PROBE_TRANSCRIPT=0   do not write a transcript under ~/.claude/projects
                           (written by default, so Air lists the session and
                           close/done/delete have something to act on)
"""
import json, os, re, signal, sys, threading, time, uuid, urllib.request

LOG_DIR = os.path.expanduser(os.environ.get("AIR_PROBE_DIR", "~/.cache/air-probe"))
os.makedirs(LOG_DIR, mode=0o700, exist_ok=True)
LOG_PATH = os.path.join(LOG_DIR, "%s-%d-claude.log" % (time.strftime("%Y%m%dT%H%M%S"), os.getpid()))
_log = open(os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "a", buffering=1)
_lock = threading.Lock()
T0 = time.monotonic()


def log(event, **kw):
    kw.update(t=time.strftime("%H:%M:%S"), dt=round(time.monotonic() - T0, 3), ev=event)
    with _lock:
        _log.write(json.dumps(kw) + "\n")


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()
    log("stdout", line=obj)


argv = sys.argv[1:]


def opt(name):
    for i, a in enumerate(argv):
        if a == name and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


log("start", argv=argv, cwd=os.getcwd(), pid=os.getpid(), ppid=os.getppid(),
    pgid=os.getpgid(0), sid=os.getsid(0),
    tty={n: os.isatty(fd) for n, fd in (("stdin", 0), ("stdout", 1), ("stderr", 2))},
    env={k: v for k, v in os.environ.items()
         if re.match(r"(CLAUDE|ANTHROPIC|JETBRAINS|IDEA|AIR|TERM|COLORTERM|MAX_THINKING)", k)})

ignore_term = os.environ.get("AIR_PROBE_IGNORE_TERM") == "1"
hook_end_reason = "other"


def on_signal(num, _frame):
    global hook_end_reason
    name = signal.Signals(num).name
    log("signal", sig=name, ignored=ignore_term and num in (signal.SIGTERM, signal.SIGHUP))
    if num == signal.SIGWINCH or (ignore_term and num in (signal.SIGTERM, signal.SIGHUP)):
        return
    hook_end_reason = name
    finish(128 + num)


for s in ("SIGTERM", "SIGINT", "SIGHUP", "SIGQUIT", "SIGUSR1", "SIGUSR2", "SIGPIPE", "SIGWINCH", "SIGCONT", "SIGTSTP"):
    signal.signal(getattr(signal, s), on_signal)


def finish(code):
    if TERMINAL:
        post_hook("SessionEnd", reason=hook_end_reason)
    log("exit", code=code)
    os._exit(code)


# ---- utility subcommands --------------------------------------------------
if argv[:1] in (["-v"], ["--version"]):
    print("2.1.318 (Claude Code)")
    log("exit", code=0)
    sys.exit(0)
if argv[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": True, "authMethod": "claude.ai", "apiProvider": "firstParty",
                      "email": "probe@example.invalid", "subscriptionType": "max"}))
    log("exit", code=0)
    sys.exit(0)
if argv and not argv[0].startswith("-"):
    log("exit", code=0, note="unhandled subcommand")
    sys.exit(0)

SESSION = opt("--session-id") or opt("--resume") or str(uuid.uuid4())
TERMINAL = os.isatty(0) and opt("--input-format") != "stream-json"

# ---- transcript, so Air sees a saved session --------------------------------
TX = None
if os.environ.get("AIR_PROBE_TRANSCRIPT", "1") != "0":
    tx_dir = os.path.expanduser("~/.claude/projects/" + re.sub(r"[^a-zA-Z0-9]", "-", os.getcwd()))
    os.makedirs(tx_dir, exist_ok=True)
    TX = os.path.join(tx_dir, SESSION + ".jsonl")
    log("transcript", path=TX, existed=os.path.exists(TX))
_parent = None


def transcript(role, text):
    global _parent
    if not TX:
        return
    u = str(uuid.uuid4())
    rec = {"type": role, "uuid": u, "parentUuid": _parent, "sessionId": SESSION, "cwd": os.getcwd(),
           "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime()), "isSidechain": False,
           "userType": "external", "version": "2.1.318",
           "message": {"role": role, "content": text if role == "user" else [{"type": "text", "text": text}]}}
    if role == "assistant":
        rec["message"].update(id="msg_" + u.replace("-", ""), type="message", model="fake-probe",
                              stop_reason="end_turn", usage={"input_tokens": 0, "output_tokens": 0})
    with open(TX, "a") as f:
        f.write(json.dumps(rec) + "\n")
    _parent = u


# ---- hooks, from Air's --settings (terminal mode) -------------------------
def post_hook(event, **extra):
    raw = opt("--settings")
    if not raw:
        return
    try:
        settings = json.loads(raw) if raw.lstrip().startswith("{") else json.load(open(raw))
    except (OSError, ValueError) as e:
        log("hook", event=event, error="settings: %s" % e)
        return
    for group in settings.get("hooks", {}).get(event, []):
        for h in group.get("hooks", []):
            if h.get("type") != "http":
                continue
            body = dict(session_id=SESSION, hook_event_name=event, cwd=os.getcwd(),
                        transcript_path=TX or "", **extra)
            req = urllib.request.Request(h["url"], data=json.dumps(body).encode(), method="POST",
                                         headers={"Content-Type": "application/json", **h.get("headers", {})})
            try:
                with urllib.request.urlopen(req, timeout=h.get("timeout", 3)) as r:
                    log("hook", event=event, status=r.status)
            except Exception as e:
                log("hook", event=event, error=str(e))


# ---- terminal mode: a line-echo "TUI" ---------------------------------------
if TERMINAL:
    post_hook("SessionStart", source="resume" if opt("--resume") else "startup")
    print("fake-claude %s  (probe, no model) — type a line; Ctrl-D ends\r" % SESSION)
    while True:
        try:
            line = sys.stdin.readline()
        except OSError as e:
            log("stdin_error", error=str(e))
            hook_end_reason = "stdin_error"
            finish(1)
        if not line:
            log("stdin_eof")
            hook_end_reason = "logout"
            finish(0)
        log("stdin", line=line.rstrip("\n"))
        post_hook("UserPromptSubmit", prompt=line.strip())
        transcript("user", line.strip())
        transcript("assistant", "probe: got it")
        print("probe: got it\r")
        post_hook("Stop", stop_hook_active=False)

# ---- chat mode: stream-json ---------------------------------------------------
replay = "--replay-user-messages" in argv


def initialize_response():
    return {"commands": [], "agents": [], "output_style": "default", "available_output_styles": ["default"],
            "models": [{"value": "default", "displayName": "Fake probe", "description": "no model runs"}],
            "account": {"email": "probe@example.invalid", "subscriptionType": "max", "apiProvider": "firstParty"}}


def state(s):
    out({"type": "system", "subtype": "session_state_changed", "state": s,
         "session_id": SESSION, "uuid": str(uuid.uuid4())})


def turn(msg):
    out({"type": "system", "subtype": "init", "session_id": SESSION, "cwd": os.getcwd(), "tools": [],
         "mcp_servers": [], "model": "fake-probe", "permissionMode": "default", "slash_commands": [],
         "apiKeySource": "none", "output_style": "default", "claude_code_version": "2.1.318",
         "uuid": str(uuid.uuid4())})
    state("running")
    text = msg.get("message", {}).get("content")
    if replay:
        out(dict(msg, session_id=SESSION, uuid=msg.get("uuid") or str(uuid.uuid4())))
    transcript("user", text)
    reply = "probe: got it"
    transcript("assistant", reply)
    out({"type": "assistant", "session_id": SESSION, "parent_tool_use_id": None, "uuid": str(uuid.uuid4()),
         "message": {"id": "msg_probe", "type": "message", "role": "assistant", "model": "fake-probe",
                     "content": [{"type": "text", "text": reply}], "stop_reason": "end_turn",
                     "stop_sequence": None, "usage": {"input_tokens": 0, "output_tokens": 0}}})
    out({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 1, "duration_api_ms": 0,
         "num_turns": 1, "result": reply, "session_id": SESSION, "total_cost_usd": 0,
         "usage": {"input_tokens": 0, "output_tokens": 0}, "modelUsage": {}, "permission_denials": [],
         "uuid": str(uuid.uuid4())})
    state("idle")


for line in sys.stdin:
    line = line.rstrip("\n")
    try:
        msg = json.loads(line)
    except ValueError:
        log("stdin", raw=line)
        continue
    log("stdin", line=msg)
    kind = msg.get("type")
    if kind == "control_request":
        sub = msg.get("request", {}).get("subtype")
        resp = initialize_response() if sub == "initialize" else {}
        out({"type": "control_response",
             "response": {"subtype": "success", "request_id": msg.get("request_id"), "response": resp}})
    elif kind == "user":
        turn(msg)
log("stdin_eof")
if ignore_term:
    # Stay alive after EOF, so a SIGTERM/SIGKILL that follows can be timed.
    while True:
        time.sleep(3600)
finish(0)
